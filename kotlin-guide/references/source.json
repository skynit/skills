          "version": "0.1.0"
        }
      }
    },
    {
      "name": "kotlin-tooling-gradle-to-kotlin-toolchain-project",
      "description_zh": "将整个 Gradle Kotlin 项目及其持续集成配置迁移到 Kotlin Toolchain",
      "upstream_frontmatter": {
        "name": "kotlin-tooling-gradle-to-kotlin-toolchain-project",
        "description": "Load when migrating or converting an entire Gradle Kotlin project (build.gradle(.kts), wrapper, libs.versions.toml, buildSrc) to the Kotlin Toolchain, including rewriting CI and replacing Gradle plugins that have no native Toolchain equivalent. Skip for porting one Gradle plugin or general Toolchain work once Gradle is gone.\n",
